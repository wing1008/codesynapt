{
  "name": "codesynapt",
  "version": "0.14.2",
  "description": "MCP-native code graph for AI agents — see blast radius live. 3D visualizer + CLI + MCP server, one package.",
  "license": "BUSL-1.1",
  "author": "",
  "homepage": "https://github.com/wing1008/codesynapt#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wing1008/codesynapt.git"
  },
  "bugs": {
    "url": "https://github.com/wing1008/codesynapt/issues"
  },
  "keywords": [
    "code-visualization",
    "dependency-graph",
    "mcp",
    "ai-coding-agent",
    "blast-radius",
    "3d",
    "electron",
    "three.js",
    "developer-tools"
  ],
  "type": "module",
  "main": "electron/main.cjs",
  "bin": {
    "codesynapt-server": "./server.js",
    "codesynapt": "./bin/codesynapt.cjs",
    "cs": "./bin/codesynapt.cjs",
    "codesynapt-mcp": "./bin/codesynapt-mcp.cjs"
  },
  "files": [
    "bin/",
    "electron/",
    "lib/",
    "public/",
    "scripts/",
    "plugin-api/",
    "parser.js",
    "scanner.js",
    "monorepo.js",
    "server.js",
    "LICENSE",
    "LICENSES.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/copy-vendor.js",
    "start": "electron .",
    "electron": "electron .",
    "server": "node server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node test.js",
    "license-check": "node scripts/license-check.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "chokidar": "^3.6.0",
    "three": "^0.160.0",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^41.0.0",
    "electron-builder": "^25.0.0",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "io.filegraph3d.app",
    "productName": "FileGraph 3D",
    "asar": true,
    "asarUnpack": [
      "node_modules/fsevents/**/*"
    ],
    "files": [
      "electron/**/*",
      "public/**/*",
      "parser.js",
      "scanner.js",
      "package.json"
    ],
    "extraResources": [],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Real-time 3D code dependency visualizer",
      "description": "FileGraph 3D visualizes how files in a codebase connect to each other. Drop a folder and watch every file orbit into place, with edges showing imports."
    },
    "publish": null
  },
  "engines": {
    "node": ">=20"
  }
}
