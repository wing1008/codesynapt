# ─── Build outputs ─────────────────────────────────────────
# Generated by `npm run dist*` — large binaries, never commit
dist/
out/
release/

# ─── Local debug / preview scratch ─────────────────────────
# Files prefixed with `_` at repo root are throwaway scripts +
# screen-recordings used during interactive debugging.
/_*.py
/_*.html
/_*.js
/_video_frames/

# Vendored copy of three.js — regenerated by postinstall
public/vendor/

# ─── Node ──────────────────────────────────────────────────
node_modules/
.npm/
.cache/
.parcel-cache/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Alternative lock files (we commit package-lock.json)
yarn.lock
pnpm-lock.yaml

# ─── Test / coverage ───────────────────────────────────────
coverage/
.nyc_output/
*.test.log

# ─── Editor / IDE ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*.swn
.project
.classpath

# ─── OS ────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Build folder rules ────────────────────────────────────
# Keep build/ for entitlements + icons, but exclude electron-builder
# temp artifacts that go in there during packaging.
build/.icon-*
build/installerHeader.bmp.cache
build/__yarn_cache__
build/electron-builder.yaml.cache

# ─── Personal / sensitive — never commit ───────────────────
# Environment files (API keys, tokens)
.env
.env.local
.env.*.local
secrets.json
config.local.*

# Code-signing material (if a developer adds them locally)
*.pem
*.key
*.crt
*.p12
*.cer
*.provisionprofile

# Personal scratch / dev notes
NOTES.md
TODO.private.md
scratch/
private/
.scratch/

# ─── App-generated state (history, traces) ─────────────────
.codesynapt/
.filegraph3d/   # legacy, kept for repos that haven't migrated yet

